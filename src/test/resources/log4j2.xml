<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

	<Properties>

		<Property name="log-path">
			C:\Users\prani\eclipse-workspace\OrangeHRM\logs
		</Property>

		<Property name="log-pattern">
			%d{yyyy-MM-dd HH:mm:ss} %-5p [%t] [%c{1}:%L] - %m%n
		</Property>
	</Properties>
	<Appenders>

		<File name="ExecutionLog"
			fileName="${log-path}/Execution-${date:yyyy-MM-dd-HH-mm-ss}.log">

			<PatternLayout pattern="${log-pattern}" />

		</File>

	</Appenders>

	<Loggers>

		<Root level="info">
			<AppenderRef ref="ExecutionLog" />
		</Root>

	</Loggers>

</Configuration>