<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <Property name="log-path">C:\Users\prani\eclipse-workspace\OrangeHRM\logs</Property>
        <Property name="log-pattern">%d{yyyy-MM-dd HH:mm:ss} %-5p [%c{1}:%L] - %m%n</Property>
    </Properties>

    <Appenders>
        <Routing name="Routing">
            <Routes pattern="$${sys:className}">
                <Route>
                    <File name="File-${sys:className}" 
                          fileName="${log-path}/${sys:className}-${date:yyyy-MM-dd-HH-mm-ss}.log">
                        <PatternLayout pattern="${log-pattern}"/>
                    </File>
                </Route>
            </Routes>
        </Routing>
    </Appenders>
    <Loggers>
        <Root level="info">
            <AppenderRef ref="Routing"/>
        </Root>
    </Loggers>
</Configuration>
